# =============================================================================
# RECOMMENDED SETTINGS — copy only what you accept into application.properties
# Do NOT replace your whole file; merge line-by-line.
# =============================================================================

# --- Database (you likely already have these) ---
# spring.datasource.url=jdbc:postgresql://localhost:5432/ubs_db
# spring.datasource.username=postgres
# spring.datasource.password=your_db_password

# --- MODE A: Hibernate manages schema (simplest local dev) ---
# Use this if you run WITHOUT Flyway. This is your current setup.
# spring.jpa.hibernate.ddl-auto=update
# Do NOT add spring.flyway.enabled=true in this mode.

# --- MODE B: Flyway manages schema + DB routines (assignment-complete) ---
# If you enable Flyway, switch Hibernate to validate — never use update with Flyway.
# spring.flyway.enabled=true
# spring.jpa.hibernate.ddl-auto=validate
# spring.flyway.baseline-on-migrate=true

# --- JWT (prefer env vars in production) ---
# app.jwt.secret=${JWT_SECRET:your_base64_secret}
# app.jwt.expiration=86400000

# --- Email (optional — enables outbound notification emails) ---
# Fix: username must be a plain email, NOT markdown like [email](mailto:email)
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=your_email@gmail.com
# spring.mail.password=your_app_password

# --- Message dispatch (only needed when mail is configured) ---
# app.message.dispatch-interval-ms=60000

# --- Existing Hibernate-created DB + first Flyway enable ---
# If tables already exist from ddl-auto=update, baseline before validate:
#   spring.flyway.baseline-on-migrate=true
# Or run Flyway repair/baseline manually, then start with MODE B.
